{
  "name": "desktop-pet-reminder",
  "private": true,
  "version": "0.1.0",
  "description": "一个 macOS 菜单栏桌面宠物提醒工具。",
  "author": "Local",
  "type": "module",
  "main": "electron/main.cjs",
  "productName": "休息时刻",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:dev": "node scripts/electron-dev.mjs",
    "desktop:build": "node scripts/package-mac-zip.mjs",
    "desktop:dmg": "npm run build && electron-builder --mac dmg --config electron-builder.json"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.27.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.0.6"
  }
}
