{
  "name": "desktop-pet-reminder",
  "private": true,
  "version": "0.1.13",
  "description": "一个 macOS 菜单栏桌面宠物提醒工具。",
  "author": "Local",
  "type": "module",
  "main": "electron/main.cjs",
  "productName": "休息时刻",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:dev": "node scripts/electron-dev.mjs",
    "desktop:build": "node scripts/package-mac-zip.mjs",
    "desktop:dmg": "npm run build && electron-builder --mac dmg --config electron-builder.json",
    "test": "TZ=Asia/Shanghai node --test tests/*.test.cjs tests/*.test.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "export:gifs": "node scripts/export-pet-gifs.mjs",
    "build:icon": "node scripts/build-macos-icon.mjs",
    "build:pet-assets": "python3 scripts/build-nailao-gifs.py",
    "build:pet-motion": "python3 scripts/build-pet-motion.py",
    "export:smooth": "python3 scripts/export-smooth-pet.py",
    "verify:animation": "node scripts/verify-animation-continuity.mjs"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.27.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.3.6"
  }
}
